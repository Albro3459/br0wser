  "type": "module",
  "description": "Small agent-focused CLI for launching and reconnecting to persistent Chrome sessions",
  "keywords": [
    "browser",
    "cdp",
    "chrome",
    "chromium",
    "cli",
    "playwright"
  ],
  "files": [
    "scripts",
    "skills",
    "README.md",
    "NOTICE.txt"
  ],
  "dependencies": {
    "playwright": "^1.40.0"
  },
  "bin": {
    "br0wser": "scripts/br0wser.js"
  },
  "scripts": {
    "version:update": "npm version patch --no-git-tag-version",
    "deploy": "npm publish --access=public",
